{
  "name": "trackify",
  "description": "A focused time tracking workspace for freelancers and small teams.",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12 <25"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:ui": "node scripts/audit-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run audit:ui && npm run test:domain && npm run build",
    "test": "npm run test:domain",
    "test:domain": "vitest run",
    "test:smoke": "playwright test tests/smoke",
    "test:a11y": "playwright test tests/a11y",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed:qa": "node scripts/database.mjs seed qa"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@gravity-ui/icons": "^2.22.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "^3.12.3",
    "@neondatabase/auth": "^0.5.0-beta",
    "@sentry/node": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/router-plugin": "1.168.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-aria-components": "1.20.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "pg": "^8.23.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
